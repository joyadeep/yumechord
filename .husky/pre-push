echo "Running pre-push hook..."

# Step 1: Lint check
echo "Running lint..."
pnpm biome check || {
    echo "❌ Lint failed! Push Aborted."
    exit 1
}

# Step 2: Build
echo "Running build..."
pnpm run build || {
    echo "❌ Build failed! Push Aborted."
    exit 1
}

echo "✅ All checks passed! Pushing..."